# Server port (Render sets PORT automatically)
PORT=3000

# Team inbox used for mailto order drafts (leave blank until configured)
TEAM_EMAIL=hello@stickyclub.example

# Order submission mode:
#   mailto -> builds client-side email draft + attachment download helpers (default)
#   server -> submits photos, napkin sketch, voice note & mockup directly to POST /api/orders
ORDER_MODE=mailto

# Password protecting GET /api/orders (HTTP Basic Auth; required to view server-stored orders)
ADMIN_PASSWORD=change-me-before-deploying
